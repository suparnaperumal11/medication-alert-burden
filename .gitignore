# Raw and intermediate data. Never committed: Synthea output, downloaded
# reference files, and the DuckDB warehouse are all reproducible from the
# fetch scripts plus the recorded seed.
data/
output/

# Synthea's own default export directory name, if it is ever run from the
# repo root without --exporter.baseDirectory.
synthea_output/

# Environments and build artefacts
.venv/
__pycache__/
*.py[cod]

# Synthea ships as a ~200 MB fat jar. Fetched, not committed.
*.jar

# R session state
.Rhistory
.RData
.Rproj.user/

# OS / editor noise
.DS_Store
Thumbs.db

# Regenerable intermediates. Every column of both is carried into
# outputs/policy_assignments.parquet by src/prioritisation/policies.py
# (verified: zero columns missing), so committing them would store the same
# alert data three times. policy_assignments.parquet is the one artefact a
# reviewer needs -- the dashboard reads it and it contains everything.
outputs/alert_features.parquet
outputs/alerts_primary.parquet

# Regenerable handoff to R (src/prioritisation/export_for_r.py). Several MB
# of flattened alerts; the committed Stage 8 artefacts are the R script and
# the figures and tables it writes.
outputs/alerts_for_r.csv
